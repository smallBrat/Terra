{
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "appUser": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "eqeqeq": "error",
    "no-implied-eval": "error",
    "no-eval": "error",
    "prefer-const": "warn",
    "no-var": "warn",
    "curly": "error",
    "no-empty": "warn",
    "no-duplicate-imports": "error"
  },
  "overrides": [
    {
      "files": ["js/**/*.js"],
      "rules": {
        "no-undef": "warn"
      }
    }
  ]
}
